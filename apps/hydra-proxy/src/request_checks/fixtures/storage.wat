(module
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 32) "marker")
  (data (i32.const 48) "x")
  (func $iovec (param $address i32) (param $size i32)
    (i32.store (i32.const 0) (local.get $address))
    (i32.store (i32.const 4) (local.get $size)))
  (func (export "_start")
    (local $fd i32)
    (loop $requests
      (call $iovec (i32.const 16) (i32.const 4))
      (drop (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))
      (if (i32.eqz (i32.load (i32.const 8))) (then (return)))
      (call $iovec (i32.const 24) (i32.const 1))
      (drop (call $read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))
      (if (i32.eq (i32.load8_u (i32.const 24)) (i32.const 116)) (then (unreachable)))
      (i32.store8 (i32.const 49) (i32.const 0))
      (if (i32.eq (i32.load8_u (i32.const 24)) (i32.const 119))
        (then
          (if (i32.eqz (call $open (i32.const 3) (i32.const 0) (i32.const 32) (i32.const 6) (i32.const 9) (i64.const 64) (i64.const 0) (i32.const 0) (i32.const 12)))
            (then
              (local.set $fd (i32.load (i32.const 12)))
              (call $iovec (i32.const 48) (i32.const 1))
              (i32.store8 (i32.const 49) (i32.eqz (call $write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8))))
              (drop (call $close (local.get $fd))))))
        (else
          (if (i32.eqz (call $open (i32.const 3) (i32.const 0) (i32.const 32) (i32.const 6) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0) (i32.const 12)))
            (then
              (local.set $fd (i32.load (i32.const 12)))
              (call $iovec (i32.const 50) (i32.const 1))
              (drop (call $read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))
              (i32.store8 (i32.const 49) (i32.eq (i32.load8_u (i32.const 50)) (i32.const 120)))
              (drop (call $close (local.get $fd)))))))
      (call $iovec (i32.const 49) (i32.const 1))
      (drop (call $write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))
      (br $requests))))
